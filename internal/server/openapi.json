{
  "openapi": "3.1.0",
  "info": {
    "title": "NovelForge Local API",
    "version": "0.1.0-alpha",
    "description": "Deterministic local REST and SSE foundation for NovelForge."
  },
  "servers": [
    { "url": "http://127.0.0.1:48090" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Server health",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "listProjects",
        "responses": {
          "200": {
            "description": "Projects discovered in the configured workspace",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projects"],
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ProjectSummary" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Project detail",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectDetail" } } }
          },
          "404": { "description": "Project not found" }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "streamEvents",
        "description": "Server-Sent Events stream. The first event is always connected.",
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": { "text/event-stream": { "schema": { "type": "string" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["product", "status", "version", "api_version"],
        "properties": {
          "product": { "type": "string" },
          "status": { "type": "string" },
          "version": { "type": "string" },
          "api_version": { "type": "string" },
          "workspace": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" },
          "uptime_seconds": { "type": "integer", "format": "int64" }
        }
      },
      "ProjectSummary": {
        "type": "object",
        "required": ["id", "title", "path", "completed_chapters", "total_chapters", "total_words"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "phase": { "type": "string" },
          "current_chapter": { "type": "integer" },
          "completed_chapters": { "type": "integer" },
          "total_chapters": { "type": "integer" },
          "total_words": { "type": "integer" },
          "current_volume": { "type": "integer" },
          "current_arc": { "type": "integer" },
          "format_version": { "type": "integer" },
          "updated_at": { "type": "string", "format": "date-time" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ProjectDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/ProjectSummary" },
          {
            "type": "object",
            "properties": { "synopsis": { "type": "string" } }
          }
        ]
      }
    }
  }
}
