{
  "paths": {
    "/api/projects/{id}/chapters/{chapter}": {
      "get": {
        "operationId": "getChapterVersionState",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}
        ],
        "responses": {
          "200": {"description": "Chapter version authoritative state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersionView"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/versions": {
      "get": {
        "operationId": "listChapterVersions",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}},
          {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}},
          {"name": "status", "in": "query", "schema": {"type": "string"}},
          {"name": "type", "in": "query", "schema": {"type": "string", "enum": ["draft", "continuity_fix", "editor_revision", "human_revision", "final", "rejected"]}},
          {"name": "author_type", "in": "query", "schema": {"type": "string", "enum": ["writer", "librarian", "editor", "human", "restore", "system"]}},
          {"name": "include_content", "in": "query", "schema": {"type": "boolean", "default": false}}
        ],
        "responses": {
          "200": {"description": "Stable chapter version page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersionPage"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      },
      "post": {
        "operationId": "saveHumanRevision",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["content"], "properties": {"content": {"type": "string", "minLength": 1, "maxLength": 2097152}}}}}},
        "responses": {
          "201": {"description": "Immutable human revision created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersion"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/versions/{version}": {
      "get": {
        "operationId": "getChapterVersion",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "version", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}}
        ],
        "responses": {
          "200": {"description": "Immutable chapter version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersion"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/diff": {
      "get": {
        "operationId": "diffChapterVersions",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "from_version", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "to_version", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "mode", "in": "query", "schema": {"type": "string", "enum": ["inline", "side_by_side"], "default": "inline"}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500}}
        ],
        "responses": {
          "200": {"description": "Bounded deterministic chapter diff", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterDiff"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/versions/{version}/check": {
      "post": {
        "operationId": "checkChapterVersion",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "version", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false}}}},
        "responses": {
          "200": {"description": "Evaluate candidate continuity, review and Truth conflicts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersionCheckResult"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/versions/{version}/restore": {
      "post": {
        "operationId": "restoreChapterVersion",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "version", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {
          "201": {"description": "New immutable restored version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersionResult"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/versions/{version}/accept": {
      "post": {
        "operationId": "acceptChapterVersion",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "version", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"reason": {"type": "string", "maxLength": 4000}}}}}},
        "responses": {
          "200": {"description": "Accepted candidate", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersionResult"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/versions/{version}/reject": {
      "post": {
        "operationId": "rejectChapterVersion",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "version", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 4000}}}}}},
        "responses": {
          "200": {"description": "Rejected candidate retained in history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterVersionResult"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/versions/{version}/finalize": {
      "post": {
        "operationId": "finalizeChapterVersion",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "version", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {
          "200": {"description": "Idempotent finalize result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterFinalizeResult"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/sync-status": {
      "get": {
        "operationId": "getChapterSyncStatus",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}
        ],
        "responses": {
          "200": {"description": "External chapter SHA sync state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterSyncStatus"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/sync": {
      "post": {
        "operationId": "syncExternalChapterEdit",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"observed_sha": {"type": "string", "minLength": 64, "maxLength": 64}}}}}},
        "responses": {
          "200": {"description": "External edit synchronized as human revision and evaluated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterSyncResult"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/rebuild": {
      "get": {
        "operationId": "getChapterDerivedStateRebuild",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}
        ],
        "responses": {
          "200": {"description": "Boundary rebuild state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DerivedStateRebuild"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/projects/{id}/chapters/{chapter}/plan-impact": {
      "get": {
        "operationId": "listChapterPlanImpact",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "chapter", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}},
          {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}}
        ],
        "responses": {
          "200": {"description": "Downstream plan impact page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterPlanImpactPage"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChapterVersion": {
        "type": "object",
        "required": ["id", "project_id", "chapter", "version_number", "type", "content_sha", "author_type", "created_at", "status", "accepted", "rejected", "active_final"],
        "properties": {
          "id": {"type": "string"},
          "project_id": {"type": "string"},
          "chapter": {"type": "integer", "minimum": 1},
          "version_number": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "enum": ["draft", "continuity_fix", "editor_revision", "human_revision", "final", "rejected"]},
          "status": {"type": "string"},
          "content": {"type": "string"},
          "content_sha": {"type": "string", "minLength": 64, "maxLength": 64},
          "parent_version": {"type": "string"},
          "author_type": {"type": "string", "enum": ["writer", "librarian", "editor", "human", "restore", "system"]},
          "provider": {"type": "string"},
          "model": {"type": "string"},
          "prompt_hash": {"type": "string"},
          "review": {"type": "object"},
          "continuity": {"type": "object"},
          "provenance": {"type": "object"},
          "created_at": {"type": "string", "format": "date-time"},
          "accepted": {"type": "boolean"},
          "rejected": {"type": "boolean"},
          "active_final": {"type": "boolean"},
          "authority": {"type": "string"},
          "rejection_reason": {"type": "string"}
        }
      },
      "ChapterVersionResult": {
        "type": "object",
        "required": ["version"],
        "properties": {"version": {"$ref": "#/components/schemas/ChapterVersion"}}
      },
      "ChapterSyncStatus": {
        "type": "object",
        "required": ["project_id", "chapter", "sync_required"],
        "properties": {
          "project_id": {"type": "string"},
          "chapter": {"type": "integer", "minimum": 1},
          "active_version_id": {"type": "string"},
          "expected_sha": {"type": "string"},
          "observed_sha": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "sync_required": {"type": "boolean"}
        }
      },
      "ChapterVersionView": {
        "type": "object",
        "required": ["project_id", "chapter", "version_count", "sync", "derived_state"],
        "properties": {
          "project_id": {"type": "string"},
          "chapter": {"type": "integer", "minimum": 1},
          "active_final": {"$ref": "#/components/schemas/ChapterVersion"},
          "latest": {"$ref": "#/components/schemas/ChapterVersion"},
          "version_count": {"type": "integer", "minimum": 0},
          "sync": {"$ref": "#/components/schemas/ChapterSyncStatus"},
          "derived_state": {"type": "string"}
        }
      },
      "ChapterVersionPage": {
        "type": "object",
        "required": ["versions", "total", "limit", "offset"],
        "properties": {
          "versions": {"type": "array", "items": {"$ref": "#/components/schemas/ChapterVersion"}},
          "total": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "offset": {"type": "integer", "minimum": 0},
          "next_offset": {"type": "integer", "minimum": 0}
        }
      },
      "ChapterDiffLine": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string", "enum": ["equal", "add", "delete", "replace"]},
          "old_line": {"type": "integer"},
          "new_line": {"type": "integer"},
          "old_text": {"type": "string"},
          "new_text": {"type": "string"}
        }
      },
      "ChapterDiffHunk": {
        "type": "object",
        "required": ["old_start", "old_lines", "new_start", "new_lines", "lines"],
        "properties": {
          "old_start": {"type": "integer"},
          "old_lines": {"type": "integer"},
          "new_start": {"type": "integer"},
          "new_lines": {"type": "integer"},
          "lines": {"type": "array", "items": {"$ref": "#/components/schemas/ChapterDiffLine"}}
        }
      },
      "ChapterDiff": {
        "type": "object",
        "required": ["from_version", "to_version", "from_sha", "to_sha", "mode", "hunks", "additions", "deletions", "unchanged", "truncated"],
        "properties": {
          "from_version": {"type": "string"},
          "to_version": {"type": "string"},
          "from_sha": {"type": "string"},
          "to_sha": {"type": "string"},
          "mode": {"type": "string", "enum": ["inline", "side_by_side"]},
          "hunks": {"type": "array", "items": {"$ref": "#/components/schemas/ChapterDiffHunk"}},
          "additions": {"type": "integer"},
          "deletions": {"type": "integer"},
          "unchanged": {"type": "integer"},
          "truncated": {"type": "boolean"},
          "next_cursor": {"type": "string"}
        }
      },
      "ChapterVersionEvaluation": {
        "type": "object",
        "required": ["proposal", "continuity", "conflicts", "evaluated_at"],
        "properties": {
          "proposal": {"type": "object"},
          "review": {"type": "object"},
          "continuity": {"type": "object"},
          "conflicts": {"type": "array", "items": {"type": "object"}},
          "evaluated_at": {"type": "string", "format": "date-time"}
        }
      },
      "ChapterVersionCheckResult": {
        "type": "object",
        "required": ["evaluation"],
        "properties": {"evaluation": {"$ref": "#/components/schemas/ChapterVersionEvaluation"}}
      },
      "ChapterSyncResult": {
        "type": "object",
        "required": ["version", "conflicts", "sync_required"],
        "properties": {
          "version": {"$ref": "#/components/schemas/ChapterVersion"},
          "proposal": {"type": "object"},
          "continuity": {"type": "object"},
          "review": {"type": "object"},
          "conflicts": {"type": "integer", "minimum": 0},
          "sync_required": {"type": "boolean"}
        }
      },
      "ChapterFinalizeResult": {
        "type": "object",
        "required": ["version", "active_final", "operation_id", "truth_events", "rebuild_status"],
        "properties": {
          "version": {"$ref": "#/components/schemas/ChapterVersion"},
          "active_final": {"$ref": "#/components/schemas/ChapterVersion"},
          "operation_id": {"type": "string"},
          "truth_events": {"type": "integer", "minimum": 0},
          "rebuild_status": {"type": "string"}
        }
      },
      "DerivedStateRebuild": {
        "type": "object",
        "required": ["boundary_chapter", "status"],
        "properties": {
          "operation_id": {"type": "string"},
          "project_id": {"type": "string"},
          "boundary_chapter": {"type": "integer", "minimum": 1},
          "source_version": {"type": "string"},
          "status": {"type": "string"},
          "current_step": {"type": "string"},
          "affected": {"type": "object"},
          "before_digest": {"type": "string"},
          "after_digest": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "error_code": {"type": "string"}
        }
      },
      "ChapterPlanImpact": {
        "type": "object",
        "required": ["id", "plan_id", "chapter", "severity", "affected_fact", "previous_assumption", "new_truth", "action_required", "reason", "source_version", "created_at"],
        "properties": {
          "id": {"type": "string"},
          "source_version": {"type": "string"},
          "plan_id": {"type": "string"},
          "chapter": {"type": "integer"},
          "severity": {"type": "string"},
          "affected_fact": {"type": "string"},
          "previous_assumption": {"type": "string"},
          "new_truth": {"type": "string"},
          "action_required": {"type": "string"},
          "reason": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "ChapterPlanImpactPage": {
        "type": "object",
        "required": ["impacts", "total", "limit", "offset"],
        "properties": {
          "impacts": {"type": "array", "items": {"$ref": "#/components/schemas/ChapterPlanImpact"}},
          "total": {"type": "integer"},
          "limit": {"type": "integer"},
          "offset": {"type": "integer"},
          "next_offset": {"type": "integer"}
        }
      }
    }
  }
}
