            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative local response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "report": {
                      "$ref": "#/components/schemas/AuthoringReport"
                    }
                  },
                  "required": [
