  "components": {
    "schemas": {
      "AuthoringEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 96
          },
          "kind": {
            "enum": [
              "skill",
              "style",
              "knowledge"
            ]
          },
          "role": {
            "enum": [
              "",
              "writing",
              "review",
              "polish",
              "planning"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "markdown": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "UTF-8 bytes limited to 16 KiB by the server."
          },
          "source": {
            "type": "string",
            "maxLength": 512
          },
          "enabled": {
            "type": "boolean"
          },
          "pinned": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "from_chapter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "pov": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "kind",
          "role",
          "title",
          "markdown",
          "source",
          "enabled",
          "pinned",
          "priority",
          "from_chapter",
          "pov"
        ],
        "additionalProperties": false
      },
      "AuthoringRules": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "phrases": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "max_phrase_occurrences": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "max_sentence_repeats": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "min_sentence_runes": {
            "type": "integer",
            "minimum": 4,
            "maximum": 200
          },
          "previous_chapters": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "enabled",
          "phrases",
          "max_phrase_occurrences",
          "max_sentence_repeats",
          "min_sentence_runes",
          "previous_chapters"
        ],
        "additionalProperties": false
      },
      "AuthoringMutation": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "entry": {
            "$ref": "#/components/schemas/AuthoringEntry"
          },
          "delete_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "rules": {
            "$ref": "#/components/schemas/AuthoringRules"
          }
        },
        "required": [
          "expected_revision"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "entry"
            ]
          },
          {
            "required": [
              "delete_id"
            ]
          },
          {
            "required": [
              "rules"
            ]
          }
        ]
      },
      "AuthoringChange": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "entry_id": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "revision",
          "replayed"
        ],
        "additionalProperties": false
      },
      "AuthoringState": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthoringEntry"
            }
          },
          "builtins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthoringEntry"
            }
          },
          "rules": {
            "$ref": "#/components/schemas/AuthoringRules"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "revision",
          "entries",
          "builtins",
          "rules",
          "total",
          "limit",
          "offset"
        ],
        "additionalProperties": false
      },
      "AuthoringFinding": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "phrase": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "phrase",
          "count",
          "limit",
          "message"
        ],
        "additionalProperties": false
      },
      "AuthoringReport": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/AuthoringFinding"
            }
          },
          "advisory": {
            "const": true
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "findings",
          "advisory",
          "truncated"
        ],
        "additionalProperties": false
      }
    }
  }
}
