{
  "paths": {
    "/api/projects/{id}/chapters/{chapter}/quality": {
      "get": {
        "operationId": "getChapterQuality",
        "parameters": [
          {"name":"id","in":"path","required":true,"schema":{"type":"string"}},
          {"name":"chapter","in":"path","required":true,"schema":{"type":"integer","minimum":1}}
        ],
        "responses": {"200":{"description":"Quality transaction state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QualityView"}}}},"default":{"$ref":"#/components/responses/Error"}}
      }
    },
    "/api/projects/{id}/chapters/{chapter}/candidates": {
      "get": {
        "operationId": "listChapterQualityCandidates",
        "parameters": [
          {"name":"id","in":"path","required":true,"schema":{"type":"string"}},
          {"name":"chapter","in":"path","required":true,"schema":{"type":"integer","minimum":1}}
        ],
        "responses": {"200":{"description":"Stable candidate metadata","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QualityCandidateList"}}}},"default":{"$ref":"#/components/responses/Error"}}
      }
    },
    "/api/projects/{id}/chapters/{chapter}/generate": {
      "post": {
        "operationId": "generateChapterQualityDraft",
        "parameters": [
          {"name":"id","in":"path","required":true,"schema":{"type":"string"}},
          {"name":"chapter","in":"path","required":true,"schema":{"type":"integer","minimum":1}},
          {"$ref":"#/components/parameters/IdempotencyKey"}
        ],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChapterPlan"}}}},
        "responses": {"202":{"description":"Draft persisted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QualityView"}}}},"default":{"$ref":"#/components/responses/Error"}}
      }
    },
    "/api/projects/{id}/chapters/{chapter}/check": {
      "post": {
        "operationId": "checkChapterQuality",
        "parameters": [
          {"name":"id","in":"path","required":true,"schema":{"type":"string"}},
          {"name":"chapter","in":"path","required":true,"schema":{"type":"integer","minimum":1}},
          {"$ref":"#/components/parameters/IdempotencyKey"}
        ],
        "requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},
        "responses": {"202":{"description":"Quality checks persisted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QualityView"}}}},"default":{"$ref":"#/components/responses/Error"}}
      }
    },
    "/api/projects/{id}/chapters/{chapter}/rewrite": {
      "post": {
        "operationId": "rewriteChapterQualityDraft",
        "parameters": [
          {"name":"id","in":"path","required":true,"schema":{"type":"string"}},
          {"name":"chapter","in":"path","required":true,"schema":{"type":"integer","minimum":1}},
          {"$ref":"#/components/parameters/IdempotencyKey"}
        ],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChapterPlan"}}}},
        "responses": {"202":{"description":"Bounded rewrite persisted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QualityView"}}}},"default":{"$ref":"#/components/responses/Error"}}
      }
    },
    "/api/projects/{id}/chapters/{chapter}/finalize": {
      "post": {
        "operationId": "finalizeChapterQuality",
        "parameters": [
          {"name":"id","in":"path","required":true,"schema":{"type":"string"}},
          {"name":"chapter","in":"path","required":true,"schema":{"type":"integer","minimum":1}},
          {"$ref":"#/components/parameters/IdempotencyKey"}
        ],
        "requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},
        "responses": {"202":{"description":"Finalize saga advanced or completed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QualityView"}}}},"default":{"$ref":"#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "schemas": {
      "ChapterPlan": {
        "type":"object","additionalProperties":false,
        "required":["chapter","title","pov","location","objective","conflict","required_beats","forbidden_outcomes","knowledge_boundary","inventory_constraints","foreshadow_obligations","ending_hook"],
        "properties": {
          "chapter":{"type":"integer","minimum":1},"title":{"type":"string","minLength":1},"pov":{"type":"string","minLength":1},"location":{"type":"string","minLength":1},"objective":{"type":"string","minLength":1},"conflict":{"type":"string","minLength":1},
          "required_beats":{"type":"array","items":{"type":"string"}},"forbidden_outcomes":{"type":"array","items":{"type":"string"}},"knowledge_boundary":{"type":"array","items":{"type":"string"}},"inventory_constraints":{"type":"array","items":{"type":"string"}},"foreshadow_obligations":{"type":"array","items":{"type":"string"}},"ending_hook":{"type":"string","minLength":1}
        }
      },
      "QualityTransaction": {
        "type":"object","required":["transaction_id","project_id","chapter","state","attempt","max_rewrites","quality_threshold","created_at","updated_at"],
        "properties": {
          "transaction_id":{"type":"string"},"project_id":{"type":"string"},"chapter":{"type":"integer"},
          "state":{"type":"string","enum":["planned","drafting","draft_ready","librarian_pending","facts_proposed","continuity_pending","continuity_pass","continuity_warn","continuity_fail","editor_pending","reviewed","rewrite_pending","final_candidate","truth_commit_pending","checkpoint_pending","completed","hold","failed"]},
          "attempt":{"type":"integer","minimum":0},"max_rewrites":{"type":"integer","minimum":0,"default":2},"quality_threshold":{"type":"number","minimum":0,"maximum":10,"default":7},"final_candidate_id":{"type":"string"},"hold_reason":{"type":"string"},"last_reason":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}
        }
      },
      "QualityCandidate": {
        "type":"object","required":["id","transaction_id","chapter","attempt","text_sha","source_version","continuity_status","selected","selection_reason","created_at"],
        "properties": {
          "id":{"type":"string"},"transaction_id":{"type":"string"},"chapter":{"type":"integer"},"attempt":{"type":"integer"},"text_sha":{"type":"string"},"source_version":{"type":"string"},"continuity_status":{"type":"string","enum":["","PASS","WARN","FAIL"]},"editor_score":{"type":["number","null"],"minimum":0,"maximum":10},"selected":{"type":"boolean"},"selection_reason":{"type":"string"},"created_at":{"type":"string","format":"date-time"}
        }
      },
      "ContinuityIssue": {
        "type":"object","required":["issue_code","severity","entity","predicate","expected","actual","evidence","source_chapter","source_version","suggested_action"],
        "properties":{"issue_code":{"type":"string"},"severity":{"type":"string","enum":["INFO","WARNING","BLOCKING"]},"entity":{"type":"string"},"predicate":{"type":"string"},"expected":{},"actual":{},"evidence":{"type":"string"},"source_chapter":{"type":"integer"},"source_version":{"type":"string"},"suggested_action":{"type":"string"}}
      },
      "ContinuityResult": {
        "type":"object","required":["status","blocking","issues"],
        "properties":{"status":{"type":"string","enum":["PASS","WARN","FAIL"]},"blocking":{"type":"boolean"},"issues":{"type":"array","items":{"$ref":"#/components/schemas/ContinuityIssue"}}}
      },
      "EditorReview": {
        "type":"object","required":["score","strengths","weaknesses","line_level_issues","pacing","characterization","prose","dialogue","ending","rewrite_recommended","summary"],
        "properties":{"score":{"type":"number","minimum":0,"maximum":10},"strengths":{"type":"array","items":{"type":"string"}},"weaknesses":{"type":"array","items":{"type":"string"}},"line_level_issues":{"type":"array","items":{"type":"string"}},"pacing":{"type":"string"},"characterization":{"type":"string"},"prose":{"type":"string"},"dialogue":{"type":"string"},"ending":{"type":"string"},"rewrite_recommended":{"type":"boolean"},"summary":{"type":"string"}}
      },
      "QualityActions": {"type":"object","required":["generate","check","rewrite","finalize"],"properties":{"generate":{"type":"boolean"},"check":{"type":"boolean"},"rewrite":{"type":"boolean"},"finalize":{"type":"boolean"}}},
      "QualitySnapshot": {
        "type":"object","required":["transaction","candidates","state_changes"],
        "properties":{"transaction":{"$ref":"#/components/schemas/QualityTransaction"},"candidates":{"type":"array","items":{"$ref":"#/components/schemas/QualityCandidate"}},"proposal":{"type":"object"},"continuity":{"$ref":"#/components/schemas/ContinuityResult"},"editor":{"$ref":"#/components/schemas/EditorReview"},"state_changes":{"type":"array","items":{"type":"object"}}}
      },
      "QualityView": {"type":"object","required":["snapshot","actions"],"properties":{"snapshot":{"$ref":"#/components/schemas/QualitySnapshot"},"actions":{"$ref":"#/components/schemas/QualityActions"}}},
      "QualityCandidateList": {"type":"object","required":["candidates","total"],"properties":{"candidates":{"type":"array","maxItems":100,"items":{"$ref":"#/components/schemas/QualityCandidate"}},"total":{"type":"integer","minimum":0}}}
    }
  }
}
