  "components": {
    "schemas": {
      "AutopilotJob": {
        "type": "object",
        "properties": {
          "chapter": {
            "type": "integer"
          },
          "completed_through": {
            "type": "integer"
          },
          "target_chapter": {
            "type": "integer"
          },
          "start_chapter": {
            "type": "integer"
          },
          "review_every": {
            "type": "integer"
          },
          "max_rewrites": {
            "type": "integer"
          },
          "max_retries": {
            "type": "integer"
          },
          "retries": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "control": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "next_run": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "paused",
              "retrying",
              "failed",
              "completed",
              "cancelled"
            ]
          },
          "actions": {
            "type": "object",
            "required": [
              "pause",
              "stop",
              "resume"
            ],
            "properties": {
              "pause": {
                "type": "boolean"
              },
              "stop": {
                "type": "boolean"
              },
              "resume": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "review_candidate_id": {
            "type": "string"
          }
        },
        "required": [
          "chapter",
          "completed_through",
          "target_chapter",
          "start_chapter",
          "review_every",
          "max_rewrites",
          "max_retries",
          "retries",
          "revision",
          "id",
          "project_id",
          "stage",
          "control",
          "error_code",
          "created_at",
          "updated_at",
          "next_run",
          "state",
          "actions"
        ],
        "additionalProperties": false
      },
      "AutopilotApproval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "review_candidate_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": "For REVIEW_REQUIRED both fields are mandatory and must match the inspected task revision and selected candidate. Stale approvals return 409."
      }
    }
