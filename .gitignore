# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
web/node_modules/

# Go workspace file
go.work
go.work.sum

# Generated metadata staging
.generated/

# env file
.env

# Project configuration may contain provider credentials and local writing rules.
.ainovel/
.novelforge/

# Editor/IDE
.idea/
.vscode/
.cache
.DS_Store

# GoReleaser artifacts. web/dist is intentionally tracked for go:embed.
/dist/
release-notes.md
/ainovel-cli
/novelforge

tasks
refer/
output*
workspace/
